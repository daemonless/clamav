ARG BASE_VERSION=15.1
FROM ghcr.io/daemonless/base:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="clamav"
{% if packages == pkgname %}ARG PACKAGES="${PKG_NAME}"
{% else %}ARG PACKAGES="clamav"
{% endif %}
LABEL org.opencontainers.image.title="ClamAV" \
      org.opencontainers.image.description="Open-source anti-virus engine: clamd scans files and mail over TCP, with freshclam keeping signatures current." \
      org.opencontainers.image.source="https://github.com/daemonless/clamav" \
      org.opencontainers.image.url="https://www.clamav.net/" \
      org.opencontainers.image.licenses="GPL-2.0-only" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Infrastructure" \
      io.daemonless.port="3310" \
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.pkg-source="pkg" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.pkg-name="${PKG_NAME}"

# Install clamav
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    mkdir -p /app /config && \
    pkg query '%v' ${PKG_NAME} > /app/version && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# Ship a signature database: containers under CIT have no network, and a first
# start shouldn't wait minutes on a download. cont-init seeds an empty
# /config/db from it; freshclam keeps it current from there.
RUN mkdir -p /usr/local/share/clamav-seed && \
    printf 'DatabaseMirror database.clamav.net\nDatabaseOwner root\n' > /tmp/freshclam.conf && \
    freshclam --config-file=/tmp/freshclam.conf --datadir=/usr/local/share/clamav-seed && \
    rm -f /tmp/freshclam.conf /usr/local/share/clamav-seed/freshclam.dat && \
    chmod -R a+rX /usr/local/share/clamav-seed

# Copy root filesystem
COPY root/ /

# Set permissions
RUN chmod +x /etc/services.d/*/run /etc/cont-init.d/* /healthz

# Expose
EXPOSE 3310 7357

# Volumes
VOLUME /config
