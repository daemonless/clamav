#!/bin/sh
# freshclam rcd unit: keeps /config/db current and tells clamd to reload
exec 2>&1

if [ "${CLAMAV_OFFLINE:-false}" = "true" ]; then
    echo "[freshclam] CLAMAV_OFFLINE=true: signature updates disabled"
    exec sleep 2147483647 # FreeBSD sleep has no "infinity"
fi

exec dsu bsd /usr/local/bin/freshclam --daemon --foreground \
    --config-file=/config/freshclam.conf
